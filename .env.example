# Copiar a un archivo privado .env.tuvoto; claves nuevas y distintas, nunca reutilizar .env SIGAPE.
TUVOTO_PUERTO=8890
TUVOTO_ORIGEN=http://127.0.0.1:8890
TUVOTO_COOKIE_SEGURA=false
TUVOTO_POSTGRES_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_MONGO_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_IDENTIDAD_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_ELECCIONES_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_ACTAS_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_RESULTADOS_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_RABBIT_CLAVE=CAMBIAR_CON_VALOR_ALEATORIO
TUVOTO_INTERNA_ELECCIONES=CAMBIAR_CON_VALOR_ALEATORIO_DE_32_O_MAS_CARACTERES
TUVOTO_INTERNA_ACTAS=CAMBIAR_CON_VALOR_ALEATORIO_DE_32_O_MAS_CARACTERES
TUVOTO_INTERNA_RESULTADOS=CAMBIAR_CON_VALOR_ALEATORIO_DE_32_O_MAS_CARACTERES
# Opcional, solo para la feria con el mapa vivo (docs/presentaciones/feria-mapa-vivo.md).
# Agregar también la URL de feria a TUVOTO_ORIGEN, separada por coma.
# TUVOTO_FERIA_IP=192.168.0.10
# TUVOTO_FERIA_PUERTO=8892
# TUVOTO_FERIA_URL=http://192.168.0.10:8892/?feria
# TUVOTO_MAPA_PUERTO=8891
