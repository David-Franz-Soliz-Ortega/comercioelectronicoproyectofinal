# Plantilla de variables; los marcadores CAMBIAR no son credenciales utilizables.
# Para el principal: copiar como .env y sustituir los marcadores.
# Para autenticación aislada: generar un archivo privado nuevo fuera de Git; ver
# pruebas/integracion/README-autenticacion.md. No copiar ni leer el .env principal.
# Usa valores aleatorios distintos por servicio; no reutilices credenciales.
POSTGRES_ADMIN_USUARIO=sigape_admin
POSTGRES_ADMIN_CLAVE=CAMBIAR_por_clave_aleatoria
IDENTIDAD_DB_USUARIO=identidad_app
IDENTIDAD_DB_CLAVE=CAMBIAR_por_clave_aleatoria
ELECCIONES_DB_USUARIO=elecciones_app
ELECCIONES_DB_CLAVE=CAMBIAR_por_clave_aleatoria
PADRON_ELECTORAL_DB_USUARIO=padron_app
PADRON_ELECTORAL_DB_CLAVE=CAMBIAR_por_clave_aleatoria
VOTACION_DB_USUARIO=votacion_app
VOTACION_DB_CLAVE=CAMBIAR_por_clave_aleatoria

MONGODB_ADMIN_USUARIO=sigape_admin
MONGODB_ADMIN_CLAVE=CAMBIAR_por_clave_aleatoria
CANDIDATURAS_DB_USUARIO=candidaturas_app
CANDIDATURAS_DB_CLAVE=CAMBIAR_por_clave_aleatoria
RESULTADOS_DB_USUARIO=resultados_app
RESULTADOS_DB_CLAVE=CAMBIAR_por_clave_aleatoria

REDIS_CLAVE=CAMBIAR_por_clave_aleatoria
RABBITMQ_ADMIN_USUARIO=sigape_admin
RABBITMQ_ADMIN_CLAVE=CAMBIAR_por_clave_aleatoria

# Único puerto publicado del principal; el override de pruebas fuerza 127.0.0.1:8888.
PUERTO_HTTP_PUBLICO=8080

# Origen público permitido para validación de CSRF (separar por coma si hay varios)
ORIGEN_PUBLICO=http://localhost:8080,http://127.0.0.1:8080

# Política de cookies (true para producción HTTPS con __Host-, false para desarrollo HTTP local)
COOKIE_SEGURA=false

# Duración de sesión en segundos (por defecto 1800 = 30 minutos)
SESION_SEGUNDOS=1800

# Claves internas entre servicios (mínimo 32 caracteres cada una, distintas por servicio)
CLAVE_INTERNA_IDENTIDAD=CAMBIAR_por_clave_interna_identidad_minimo_32_caracteres
CLAVE_INTERNA_ELECCIONES=CAMBIAR_por_clave_interna_elecciones_minimo_32_caracteres
CLAVE_INTERNA_PADRON_ELECTORAL=CAMBIAR_por_clave_interna_padron_minimo_32_caracteres
CLAVE_INTERNA_CANDIDATURAS=CAMBIAR_por_clave_interna_candidaturas_minimo_32_caracteres
CLAVE_INTERNA_VOTACION=CAMBIAR_por_clave_interna_votacion_minimo_32_caracteres
CLAVE_INTERNA_RESULTADOS=CAMBIAR_por_clave_interna_resultados_minimo_32_caracteres
CLAVE_INTERNA_GATEWAY_GRAPHQL=CAMBIAR_por_clave_interna_graphql_minimo_32_caracteres

# Solo para compose.auth-test.yml: copia temporal absoluta, nunca el repositorio principal.
# El preparador documentado sustituye esta ruta y genera claves independientes.
SIGAPE_AUTH_COPIA=/tmp/CAMBIAR_por_copia_aislada
