          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      },
      "post": {
        "summary": "Crear proceso",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
