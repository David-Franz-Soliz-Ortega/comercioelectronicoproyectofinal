    "/mesas/{id}/contexto": {
      "get": {
        "summary": "Comprobar asignación y obtener candidatos",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/publico/candidatos/{id}/foto": {
      "get": {
        "summary": "Fotografía del candidato de la elección actual",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/configuracion/candidatos/{id}/foto": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Actualizar solo fotografía sin cambiar el catálogo ni los votos",
        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "foto"
                ],
                "properties": {
                  "foto": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Fotografía actualizada"
          },
          "403": {
            "description": "Acceso denegado"
          },
          "404": {
            "description": "Candidato no disponible"
          },
          "422": {
            "description": "JPEG/PNG inválido"
          }
        }
      }
    },
    "/configuracion/procesos/{id}": {
      "get": {
        "summary": "Consultar procesos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registro consultado o actualizado"
          },
          "204": {
            "description": "Retirado sin borrar historial"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Rol o alcance denegado"
          },
          "404": {
            "description": "No disponible"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          }
        }
      },
      "put": {
        "summary": "Actualizar procesos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
