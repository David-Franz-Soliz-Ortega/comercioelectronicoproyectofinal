        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "codigo",
                  "unidad"
                ],
                "properties": {
                  "codigo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unidad": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/configuracion/mesas/{id}/asignar": {
      "post": {
        "summary": "Asignar cuenta a mesa sin conceder roles",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
