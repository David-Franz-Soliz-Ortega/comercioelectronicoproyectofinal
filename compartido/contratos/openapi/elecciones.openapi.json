{
  "openapi": "3.1.0",
  "info": {
    "title": "TUVOTO · Elecciones",
    "version": "0.2.0",
    "description": "TUVOTO: implementación de desarrollo, sin certificación electoral."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/publico/actual": {
      "get": {
        "summary": "Proceso actual para recepción de actas; compatibilidad con consumidores anteriores",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        }
      }
    },
    "/configuracion/procesos": {
      "get": {
        "summary": "Procesos de la organización autorizada",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      },
      "post": {
        "summary": "Crear proceso",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombre",
                  "cargo",
                  "tipo",
                  "unidad"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cargo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tipo": {
                    "enum": [
                      "universidad",
                      "municipio",
                      "otra"
                    ]
                  },
                  "unidad": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/configuracion/procesos/{id}/actual": {
      "post": {
        "summary": "Publicar cargo y destacar su evento; seleccionar proceso actual para recepción de actas",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/configuracion/procesos/{id}/candidatos": {
      "post": {
        "summary": "Agregar candidato antes de asignar mesas",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre"
                ],
                "additionalProperties": false,
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "foto": {
                    "type": "string",
                    "description": "JPEG/PNG en data URL; máximo 2 MB"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/configuracion/procesos/{id}/mesas": {
      "post": {
        "summary": "Agregar mesa esperada",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
