          }
        ],
        "responses": {
          "200": {
            "description": "Registro consultado o actualizado"
          },
          "204": {
            "description": "Retirado sin borrar historial"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Rol o alcance denegado"
          },
          "404": {
            "description": "No disponible"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Datos inválidos"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombre",
                  "cargo",
                  "tipo",
                  "unidad"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cargo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tipo": {
                    "enum": [
                      "universidad",
                      "municipio",
                      "otra"
                    ]
                  },
                  "unidad": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Desactivar o archivar procesos",
