        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombre",
                  "cargo",
                  "tipo",
                  "unidad"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cargo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tipo": {
                    "enum": [
                      "universidad",
                      "municipio",
                      "otra"
                    ]
                  },
                  "unidad": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
