    "/api/v1/actas/lectura": {
      "post": {
        "summary": "Proponer destino y cifras de una fotografía, sin registrar ni publicar",
        "operationId": "leer_api_v1_actas_lectura_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FotoParaLectura"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropuestaLectura"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "409": {
            "description": "Recepción cerrada o ninguna mesa candidata abierta"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Sin permiso o mesa no asignada"
          },
          "429": {
            "description": "Dos lecturas en curso"
          },
          "503": {
            "description": "Motor de lectura no disponible"
          },
          "504": {
            "description": "Lectura agotó su tiempo"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ],
        "description": "Requiere OPERADOR asignado, recepción abierta, Origin y CSRF válidos. Solo sugiere cifras impresas; no persiste fotografías, no registra actas ni publica eventos. Los campos no leídos son null. La confirmación humana se realiza por el endpoint de registro existente. Respuesta privada Cache-Control: no-store. Con candidatas, identifica la mesa y el cargo entre las mesas asignadas del operador; si hay empate devuelve opciones sin cifras."
      }
    }
  },
  "components": {
    "schemas": {
      "Anulacion": {
        "properties": {
          "idSolicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Idsolicitud"
          },
          "versionAnterior": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Versionanterior"
          },
          "motivo": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Motivo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idSolicitud",
          "versionAnterior",
          "motivo"
        ],
        "title": "Anulacion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NuevaActa": {
        "properties": {
          "idMesa": {
            "type": "string",
            "format": "uuid",
            "title": "Idmesa"
          },
          "idSolicitud": {
            "type": "string",
            "format": "uuid",
            "title": "Idsolicitud"
          },
          "versionAnterior": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Versionanterior"
          },
          "foto": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 14000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Foto"
          },
          "idActaOrigen": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idactaorigen"
          },
          "votos": {
            "items": {
              "$ref": "#/components/schemas/Voto"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Votos"
          },
          "blancos": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Blancos"
          },
          "nulos": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Nulos"
          },
          "total": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "confirmado": {
            "type": "boolean",
            "title": "Confirmado"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idMesa",
          "idSolicitud",
          "versionAnterior",
          "votos",
          "blancos",
          "nulos",
          "total",
          "confirmado"
        ],
        "title": "NuevaActa"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Voto": {
        "properties": {
          "idCandidato": {
            "type": "string",
            "format": "uuid",
            "title": "Idcandidato"
          },
          "cantidad": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Cantidad"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idCandidato",
          "cantidad"
        ],
        "title": "Voto"
      },
      "FotoParaLectura": {
        "properties": {
          "idMesa": {
            "type": "string",
            "format": "uuid",
            "title": "Idmesa",
            "description": "Mesa elegida por el operador. Excluye candidatas."
          },
          "candidatas": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 60,
            "title": "Candidatas",
            "description": "Mesas asignadas entre las que Actas identifica el destino de la foto. Elecciones confirma cada una; las ajenas o cerradas no participan."
          },
          "foto": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 1,
            "title": "Foto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "foto"
        ],
        "title": "FotoParaLectura",
        "description": "Indica idMesa o candidatas, no ambas."
      },
      "VotoLeido": {
        "properties": {
          "idCandidato": {
            "type": "string",
            "format": "uuid",
            "title": "Idcandidato"
          },
          "cantidad": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cantidad"
          }
        },
        "type": "object",
        "required": [
          "idCandidato",
          "cantidad"
        ],
        "title": "VotoLeido"
      },
      "PropuestaLectura": {
        "properties": {
          "votos": {
            "items": {
              "$ref": "#/components/schemas/VotoLeido"
            },
            "type": "array",
            "title": "Votos"
          },
          "blancos": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blancos"
          },
          "nulos": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nulos"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "completa": {
            "type": "boolean",
            "title": "Completa"
          },
          "sumaCoincide": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sumacoincide"
          },
          "advertencias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Advertencias"
          },
          "requiereRevision": {
            "type": "boolean",
            "const": true,
            "title": "Requiererevision"
          },
          "motor": {
            "type": "string",
            "const": "tesseract",
            "title": "Motor"
          },
          "idMesa": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idmesa",
            "description": "Destino de las cifras; null si no se identificó."
          },
          "detectada": {
            "type": "boolean",
            "title": "Detectada",
            "description": "true si el destino se identificó en la foto (código de mesa, candidaturas, cargo o sector impresos)."
          },
          "opciones": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "title": "Opciones",
            "description": "Destinos empatados para que el operador elija; nunca se adivina."
          }
        },
        "type": "object",
        "required": [
          "votos",
          "blancos",
          "nulos",
          "total",
          "completa",
          "sumaCoincide",
          "advertencias",
          "requiereRevision",
          "motor"
        ],
        "title": "PropuestaLectura"
      }
    },
    "securitySchemes": {
      "sesion": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tuvoto-sesion"
      }
    }
  }
}
