{
  "openapi": "3.1.0",
  "info": {
    "title": "TUVOTO · Identidad",
    "version": "0.1.0",
    "description": "TUVOTO: implementación de desarrollo, sin certificación electoral. Las escrituras requieren Origin autorizado, cookie CSRF y X-CSRF-Token. X-Organizacion selecciona alcance; no concede permisos. Las contraseñas admiten máximo 72 bytes UTF-8."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/autenticacion/csrf": {
      "get": {
        "summary": "Obtener CSRF antes del login",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        }
      }
    },
    "/autenticacion/login": {
      "post": {
        "summary": "Iniciar sesión",
        "responses": {
          "200": {
            "description": "Operación completada"
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Permiso o alcance denegado"
          },
          "409": {
            "description": "Conflicto"
          },
          "422": {
            "description": "Entrada inválida"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "usuario",
                  "contrasena"
                ],
                "properties": {
                  "usuario": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contrasena": {
                    "type": "string",
                    "writeOnly": true
                  }
                }
              }
            }
          }
        }
      }
    },
