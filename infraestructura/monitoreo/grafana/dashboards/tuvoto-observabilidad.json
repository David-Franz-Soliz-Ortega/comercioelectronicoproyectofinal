    {
      "id": 1,
      "title": "Disponibilidad Global (SLO Target: 99.0%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 98.0 },
              { "color": "green", "value": 99.0 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "clamp_max(100 * (1 - (sum(rate(tuvoto_http_requests_total{estado=~\"5..\"}[5m])) or vector(0)) / (sum(rate(tuvoto_http_requests_total[5m])) > 0 or vector(1))), 100)",
          "legendFormat": "Disponibilidad"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tasa de Error 5xx (SLO Max: 1.0%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(tuvoto_http_requests_total{estado=~\"5..\"}[5m])) or vector(0)) / (sum(rate(tuvoto_http_requests_total[5m])) > 0 or vector(1))",
          "legendFormat": "Tasa Error 5xx"
        }
      ]
    },
    {
